# ---------------------------------------------------------------------------
# Core application
# ---------------------------------------------------------------------------
# PostgreSQL connection string used by Prisma CLI and the application.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reporlog?schema=public"

# Optional: separate database used by the integration test suite.
# The tests are skipped when this is not set.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reporlog_test?schema=public"

NODE_ENV="development"
APP_BASE_URL="http://localhost:3000"
DEFAULT_TIMEZONE="Asia/Kolkata"
LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# Authentication (Milestone 2)
# ---------------------------------------------------------------------------
# Used to sign/encrypt GitHub OAuth credentials and sessions.
# Generate one with: openssl rand -base64 32
# Required in production and required for GitHub sign-in.
AUTH_SECRET=""

# GitHub OAuth App credentials.
# Create an OAuth App at https://github.com/settings/developers.
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional space-separated OAuth scopes. Defaults to "read:user user:email repo".
# The repo scope is needed to read private repositories for the authenticated
# owner; use a GitHub App for finer-grained least-privilege access.
GITHUB_OAUTH_SCOPES=""

# ---------------------------------------------------------------------------
# GitHub App (optional integration model; Milestone 3+)
# ---------------------------------------------------------------------------
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Background jobs (Milestone 4+)
# ---------------------------------------------------------------------------
JOB_SECRET=""

# ---------------------------------------------------------------------------
# Daily summaries (optional; Milestone 7)
# ---------------------------------------------------------------------------
SUMMARY_PROVIDER=""
SUMMARY_PROVIDER_API_KEY=""
SUMMARY_MODEL=""
